{
  "name": "workroom",
  "version": "1.0.0",
  "description": "Mobile-first PWA for work-group messaging with full-resolution photos, image IDs and one-click chat export",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "node --watch --no-warnings=ExperimentalWarning server.js",
    "icons": "node scripts/make-icons.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2"
  }
}
